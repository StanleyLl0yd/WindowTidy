#include <windows.h>
#include <commctrl.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
1 24 "res\\WindowTidy.manifest"
IDI_WINDOWTIDY ICON "res\\WindowTidy.ico"

IDD_SETTINGS DIALOGEX 0, 0, 360, 238
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Window Tidy Settings"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX        "Global hotkeys", IDC_TXT_GLOBAL, 8, 8, 344, 98
    LTEXT           "Tidy / Undo:", IDC_TXT_TIDY, 16, 24, 136, 12
    CONTROL         "", IDC_HK_TIDY, "msctls_hotkey32", WS_TABSTOP, 160, 22, 162, 14
    PUSHBUTTON      "X", IDC_CLEAR_TIDY, 330, 22, 15, 14
    LTEXT           "Always on top:", IDC_TXT_TOPMOST, 16, 39, 136, 12
    CONTROL         "", IDC_HK_TOPMOST, "msctls_hotkey32", WS_TABSTOP, 160, 37, 162, 14
    PUSHBUTTON      "X", IDC_CLEAR_TOPMOST, 330, 37, 15, 14
    LTEXT           "Move to next monitor:", IDC_TXT_NEXT, 16, 54, 136, 12
    CONTROL         "", IDC_HK_NEXT, "msctls_hotkey32", WS_TABSTOP, 160, 52, 162, 14
    PUSHBUTTON      "X", IDC_CLEAR_NEXT, 330, 52, 15, 14
    LTEXT           "Move to previous:", IDC_TXT_PREV, 16, 69, 136, 12
    CONTROL         "", IDC_HK_PREV, "msctls_hotkey32", WS_TABSTOP, 160, 67, 162, 14
    PUSHBUTTON      "X", IDC_CLEAR_PREV, 330, 67, 15, 14
    LTEXT           "Minimize active:", IDC_TXT_MINIMIZE, 16, 84, 136, 12
    CONTROL         "", IDC_HK_MINIMIZE, "msctls_hotkey32", WS_TABSTOP, 160, 82, 162, 14
    PUSHBUTTON      "X", IDC_CLEAR_MINIMIZE, 330, 82, 15, 14

    GROUPBOX        "Behavior", IDC_TXT_BEHAVIOR, 8, 110, 344, 84
    CONTROL         "Skip always-on-top windows in Tidy", IDC_SKIP_TOPMOST, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 16, 123, 246, 12
    CONTROL         "Tidy only on current monitor", IDC_ONLY_CURRENT, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 16, 139, 246, 12
    LTEXT           "Move mode:", IDC_TXT_MOVE_MODE, 16, 156, 136, 12
    COMBOBOX        IDC_MOVE_MODE, 160, 153, 180, 76, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    CONTROL         "Start with Windows", IDC_RUN_AT_STARTUP, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 16, 176, 246, 12

    LTEXT           "Click X to disable a hotkey.", IDC_HOTKEY_HELP, 12, 200, 330, 12
    DEFPUSHBUTTON   "Save", IDOK, 240, 217, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 299, 217, 50, 14
END

IDD_WINDOW_DIAGNOSTICS DIALOGEX 0, 0, 430, 276
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Window diagnostics"
FONT 9, "Segoe UI"
BEGIN
    EDITTEXT IDC_WINDOW_REPORT, 8, 8, 414, 240,
             ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Close", IDOK, 372, 254, 50, 14
END
